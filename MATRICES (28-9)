1) #include <stdio.h>

int main() {
    // Matriz bidimensional de 3x2
    int matriz[3][2];
    int i, j;

    printf("Ingrese los valores de la matriz 3x2:\n");

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 2; j++) {
            printf("Matriz[%d][%d]: ", i, j);
            scanf("%d", &matriz[i][j]);
        }
    }

    printf("\nMatriz 3x2:\n");

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 2; j++) {
            printf("%d ", matriz[i][j]);
        }
        printf("\n");
    }
    return 0;

B) #include <stdio.h>

int main() {
    // Matriz tridimensional de 2x3x2
    int matriz[2][3][2];
    int i, j, k;

    printf("Ingrese los valores de la matriz 2x3x2:\n");

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 3; j++) {
            for (k = 0; k < 2; k++) {
                printf("Matriz[%d][%d][%d]: ", i, j, k);
                scanf("%d", &matriz[i][j][k]);
            }
        }
    }

    printf("\nMatriz tridimensional:\n");

    for (i = 0; i < 2; i++) {
        printf("\nCapa %d:\n", i);

        for (j = 0; j < 3; j++) {
            for (k = 0; k < 2; k++) {
                printf("%d ", matriz[i][j][k]);
            }
            printf("\n");
        }
    }

    return 0;
}

2) #include <stdio.h>

int main() {
    // 4 filas y 4 columnas:
    // A | B | AND | OR
    int matriz[4][4] = {
        {0, 0, 0, 0},
        {0, 1, 0, 1},
        {1, 0, 0, 1},
        {1, 1, 1, 1}
    };

    int i;

    printf("TABLA DE VERDAD\n");
    printf("-------------------------\n");
    printf(" A | B | AND | OR\n");
    printf("-------------------------\n");

    for (i = 0; i < 4; i++) {
        printf(" %d | %d |  %d  | %d\n",
               matriz[i][0],
               matriz[i][1],
               matriz[i][2],
               matriz[i][3]);
    }

    return 0;
}

3) #include <stdio.h>

int main() {
    int matriz[4][4];
    int i;

    // Valores de A y B
    matriz[0][0] = 0;
    matriz[0][1] = 0;

    matriz[1][0] = 0;
    matriz[1][1] = 1;

    matriz[2][0] = 1;
    matriz[2][1] = 0;

    matriz[3][0] = 1;
    matriz[3][1] = 1;

    // Calcular AND y OR
    for (i = 0; i < 4; i++) {
        matriz[i][2] = matriz[i][0] && matriz[i][1];
        matriz[i][3] = matriz[i][0] || matriz[i][1];
    }

    // Imprimir tabla
    printf(" A | B | AND | OR\n");
    printf("-----------------\n");

    for (i = 0; i < 4; i++) {
        printf(" %d | %d |  %d  | %d\n",
               matriz[i][0],
               matriz[i][1],
               matriz[i][2],
               matriz[i][3]);
    }

    return 0;
}
}
